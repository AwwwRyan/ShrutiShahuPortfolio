# Postgres connection string (Neon, via Vercel Storage)
DATABASE_URL=

# Vercel Blob read/write token (Vercel Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Gmail SMTP sender for password-reset and contact-form emails. GMAIL_USER is the
# Gmail account emails are sent FROM (needs 2-Step Verification enabled); GMAIL_APP_PASSWORD
# is a 16-character App Password generated at myaccount.google.com/apppasswords — NOT the
# account's normal login password. See memory.md for why this replaced Resend.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# NextAuth — NEXTAUTH_SECRET: generate with `openssl rand -base64 32` (or reuse the
# dev value below in a NEW production secret, never the same one). NEXTAUTH_URL must
# be the real deployed URL in production (e.g. https://your-project.vercel.app or a
# custom domain) — localhost only works for local dev.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin seed script (used once by `npx prisma db seed` / the seed script to create the AdminUser row)
ADMIN_EMAIL=
ADMIN_PASSWORD=
