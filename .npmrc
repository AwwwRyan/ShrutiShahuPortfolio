# next-auth@5.0.0-beta.32 declares an optional peer on nodemailer@"^7.0.7 || ^8.0.5" (for its
# own unused Email/magic-link provider) — this project uses nodemailer@^9.0.5 (needed to clear
# a real npm-audit advisory, GHSA-p6gq-j5cr-w38f, fixed only in 9.0.5+), which npm's default
# resolver treats as a hard ERESOLVE conflict even though the peer is optional and this app only
# ever uses next-auth's Credentials provider. See memory.md decision #24.
legacy-peer-deps=true
