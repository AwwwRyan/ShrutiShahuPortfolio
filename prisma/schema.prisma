// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  order     Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryToCategory")
  projects  Project[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  header      String
  description String
  coverImage  String?
  gallery     String[]      @default([])
  videoUrl    String?
  /// When set, the project's card links straight here (opened in a new tab) instead of
  /// its own /project/[id] page — for pieces that are really just a pointer to a
  /// client's own published article rather than a piece meant to have its own detail page.
  externalUrl String?
  client      String?
  tags        String[]      @default([])
  featured    Boolean       @default(false)
  order       Int           @default(0)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  links       ProjectLink[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProjectLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String                @id @default(cuid())
  email        String                @unique
  passwordHash String
  resetTokens  PasswordResetToken[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Singleton row (id is always "singleton") holding site-wide editable content.
model SiteContent {
  id           String   @id @default("singleton")
  aboutMe      String   @default("")
  profilePhoto String?
  resumeUrl    String?
  contactEmail String?
  socialLinks  Json?
  updatedAt    DateTime @updatedAt
}
