// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  order     Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryToCategory")
  projects  Project[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Project {
  id                  String        @id @default(cuid())
  header              String
  description         String
  coverImage          String?
  gallery             String[]      @default([])
  videoUrl            String?
  /// When set AND showDescriptionPage is false, the project's card links straight here
  /// (opened in a new tab / in-app PDF modal) instead of its own /project/[id] page —
  /// for pieces that are really just a pointer to a client's own published article, or
  /// a document uploaded to be read directly rather than via a description page.
  externalUrl         String?
  /// Whether clicking this project's card opens its own /project/[id] description page
  /// (true) or, when externalUrl is set, opens externalUrl directly instead (false).
  /// Decoupled from externalUrl itself so a document can stay attached/uploaded without
  /// forcing the card to bypass the description page.
  showDescriptionPage Boolean       @default(true)
  client              String?
  tags                String[]      @default([])
  featured            Boolean       @default(false)
  order               Int           @default(0)
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  links               ProjectLink[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model ProjectLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  resetTokens  PasswordResetToken[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Singleton row (id is always "singleton") holding site-wide editable content.
model SiteContent {
  id           String   @id @default("singleton")
  aboutMe      String   @default("")
  profilePhoto String?
  resumeUrl    String?
  contactEmail String?
  socialLinks  Json?
  updatedAt    DateTime @updatedAt
}

/// One human-readable line per admin mutation (category/project/site-content
/// create/update/delete/reorder), shown as a feed on the dashboard. Visibility
/// only — deliberately not a full before/after field diff, since that's what
/// would be needed to support in-app revert, which isn't what this is for
/// (Neon's own point-in-time restore covers that instead).
model ActivityLogEntry {
  id        String   @id @default(cuid())
  summary   String
  createdAt DateTime @default(now())
}
